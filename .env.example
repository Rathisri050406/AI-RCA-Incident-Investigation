APP_ENV=local
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Default is SQLite so the project runs with zero setup. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/incident_rca
DATABASE_URL=

# LLM: none = built-in template narrative; openai_compatible = any OpenAI-style endpoint
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# auto | sbert | tfidf
EMBEDDING_BACKEND=auto

# local = everything on one laptop. distributed = see README section "Distributed mode"
DEPLOY_MODE=local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
